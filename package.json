{
  "name": "vibe-cli",
  "version": "1.0.0",
  "description": "A CLI tool for vibe coding and development assistance",
  "main": "src/index.js",
  "bin": {
    "vibe": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "cli",
    "vibe",
    "coding",
    "llm",
    "embeddings",
    "sqlite-vec"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.21.3",
    "@google/generative-ai": "^0.14.1",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "dotenv": "^16.4.5",
    "figlet": "^1.8.0",
    "inquirer": "^9.2.15",
    "node-fetch": "^2.7.0",
    "openai": "^4.28.0",
    "ora": "^5.4.1",
    "sqlite3": "^5.1.7",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5"
  },
  "overrides": {
    "sqlite3": "npm:better-sqlite3@^9.4.3"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "type": "module"
}

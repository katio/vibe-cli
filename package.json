{
  "name": "vibe-cli",
  "version": "1.0.0",
  "description": "A CLI tool for local AI-powered document search and Q&A using vector embeddings",
  "type": "module",
  "main": "src/cli.js",
  "bin": {
    "vibe": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "dev": "NODE_ENV=development node src/cli.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "test": "NODE_ENV=test mocha test/**/*.test.js --timeout 10000 --exit",
    "test:watch": "NODE_ENV=test mocha test/**/*.test.js --watch --timeout 10000",
    "test:coverage": "NODE_ENV=test c8 mocha test/**/*.test.js --timeout 10000 --exit",
    "prepare": "husky install"
  },
  "keywords": [
    "cli",
    "ai",
    "llm",
    "embeddings",
    "vector-search",
    "sqlite",
    "openai",
    "anthropic",
    "gemini"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.23.0",
    "@google/generative-ai": "^0.3.1",
    "better-sqlite3": "^9.4.3",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "figlet": "^1.6.0",
    "glob": "^10.3.10",
    "inquirer": "^9.2.15",
    "node-addon-api": "^7.1.0",
    "openai": "^4.28.0",
    "ora": "^8.0.1",
    "sqlite-vec": "^0.1.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.3",
    "@commitlint/config-conventional": "^19.0.3",
    "c8": "^9.1.0",
    "chai": "^5.1.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-mocha": "^10.4.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.10",
    "lint-staged": "^15.2.0",
    "mocha": "^10.4.0",
    "prettier": "^3.2.5",
    "sinon": "^17.0.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "lint-staged": {
    "*.{js,json,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "eslintConfig": {
    "extends": [
      "eslint:recommended",
      "plugin:node/recommended",
      "plugin:jest/recommended",
      "plugin:prettier/recommended"
    ],
    "env": {
      "node": true,
      "es2021": true,
      "jest/globals": true
    },
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "node/no-unpublished-import": "off",
      "node/no-unsupported-features/es-syntax": [
        "error",
        { "ignores": ["modules"] }
      ]
    }
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  },
  "overrides": {}
}

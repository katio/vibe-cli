{
  "name": "vibe-cli",
  "version": "1.0.0",
  "description": "A CLI tool for vibe coding and development assistance",
  "main": "src/index.js",
  "bin": {
    "vibe": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "test": "mocha test/**/*.test.js --timeout 10000 --exit",
    "test:watch": "mocha test/**/*.test.js --watch --timeout 10000",
    "test:coverage": "c8 mocha test/**/*.test.js --timeout 10000 --exit"
  },
  "keywords": [
    "cli",
    "vibe",
    "coding",
    "llm",
    "embeddings",
    "sqlite-vec"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.23.0",
    "@google/generative-ai": "^0.3.1",
    "better-sqlite3": "^9.4.3",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "glob": "^10.3.10",
    "node-addon-api": "^7.1.0",
    "openai": "^4.28.0",
    "sqlite-vec": "^0.1.6",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "chai": "^5.1.2",
    "c8": "^9.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-mocha": "^10.4.0",
    "eslint-plugin-prettier": "^5.1.3",
    "mocha": "^10.4.0",
    "prettier": "^3.2.5",
    "sinon": "^17.0.1"
  },
  "overrides": {},
  "engines": {
    "node": ">=16.0.0"
  },
  "type": "module"
}
